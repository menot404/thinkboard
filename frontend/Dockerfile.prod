# ── Stage 1 : build ──────────────────────────────────────────
FROM node:20-alpine AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./ 
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# ── Stage 2 : production ──────────────────────────────────────
FROM nginx:1.25-alpine

RUN apk add --no-cache gettext

# Sécurité : utilisateur non-root
RUN addgroup -S thinkboardgroup && adduser -S thinkboarduser -G thinkboardgroup

# Config Nginx custom (SPA fallback + gzip + cache headers)
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Artefacts du build uniquement
COPY --from=build /app/dist /usr/share/nginx/html
COPY public/env.template.js /usr/share/nginx/html/env.template.js

# Droits sur les fichiers nginx

RUN chown -R thinkboarduser:thinkboardgroup /usr/share/nginx/html && \
    chown -R thinkboarduser:thinkboardgroup /var/cache/nginx && \
    chown -R thinkboarduser:thinkboardgroup /var/log/nginx && \
    touch /var/run/nginx.pid && chown thinkboarduser:thinkboardgroup /var/run/nginx.pid

USER thinkboarduser

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1

CMD sh -c "envsubst < /usr/share/nginx/html/env.template.js > /usr/share/nginx/html/env.js \
    && nginx -g 'daemon off;'"