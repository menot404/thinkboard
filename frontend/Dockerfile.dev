FROM node:20-alpine

# pnpm via corepack (inclus dans Node 20, pas de install supplémentaire)
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@latest --activate

RUN apk add --no-cache gettext

WORKDIR /app

# Cache layer : seulement les fichiers de dépendances
COPY package.json pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 5173

CMD sh -c "envsubst < public/env.template.js > public/env.js && pnpm dev --host"